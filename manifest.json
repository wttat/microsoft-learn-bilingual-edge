{
  "manifest_version": 3,
  "name": "Learn 官方中英对照",
  "version": "1.0.5",
  "description": "并排阅读 Microsoft Learn 官方中文和英文正文，按对应章节双向同步滚动。不翻译、不使用 AI。",
  "permissions": ["storage"],
  "host_permissions": ["https://learn.microsoft.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开或收起 Learn 官方中英对照"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.microsoft.com/*"],
      "js": ["core.js", "article.js", "sync.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["reader.css"],
      "matches": ["https://learn.microsoft.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://learn.microsoft.com"
  }
}
